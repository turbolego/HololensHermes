<Page x:Class="HololensSatelliteViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <Canvas x:Name="HologramCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Padding="16"
                Background="#DD000000"
                CornerRadius="8"
                BorderBrush="#FFFFFF"
                BorderThickness="2">
            <StackPanel>
                <TextBlock Text="🛰️ Satellite Tracker"
                           Foreground="#FFFFFFFF"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusText"
                           Foreground="#FFFF9900"
                           FontSize="20"
                           Margin="0,8,0,0"
                           Text="Initializing..."
                           TextWrapping="Wrap"
                           MaxWidth="400" />
                <TextBlock x:Name="CountText"
                           Foreground="#FFFFFF00"
                           FontSize="22"
                           Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           Text="Satellites: 0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
